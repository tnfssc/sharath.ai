{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upload-cdn",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "CDN_BASE_URL": "https://cdn.sharath.uk/"
  }
}
