{
  "extends": "@sharath/typescript-config/react.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["convex/**", ".content-collections", "dist", "node_modules"],
  "compilerOptions": {
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "content-collections": ["./.content-collections/generated"]
    },
    "types": ["vite/client"]
  }
}
