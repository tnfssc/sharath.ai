{
  "name": "sharathai",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo watch dev",
    "dev:web": "turbo watch dev --filter=@sharath/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "clean": "git clean -xdf node_modules apps/*/node_modules packages/*/node_modules **/.turbo **/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@sharath/typescript-config": "workspace:*",
    "turbo": "^2.5.8"
  }
}
